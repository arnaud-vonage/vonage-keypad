    "debug": "vcr debug"
  },
  "dependencies": {
    "@vonage/client-sdk": "^2.7.1",
    "@vonage/jwt": "^1.17.1",
    "@vonage/vcr-sdk": "^2.1.6",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "nodemon": "^3.1.10"
  }
}
