{
  "name": "vonage-keypad",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-vonage/vonage-keypad.git"
  },
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --minify --outfile=public/app.js",
    "start": "npm run build && node index.js",
